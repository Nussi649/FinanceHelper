<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:ignore="LockedOrientationActivity">

    <!-- OneDrive sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light">
        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".AssetAccountDetailsActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".AssetsActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".BudgetAccountDetailsActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".BudgetsActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".SettingsActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name=".RecurringTxActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation"
            android:screenOrientation="portrait">
        </activity>
        <!-- unsaved edits live only in the view, so survive configuration changes instead of recreating -->
        <activity android:name=".JsonEditorActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
        </activity>
        <!--
            Where the Microsoft sign-in page hands control back. The path is the base64 SHA-1 of
            the key the APK is signed with (here: the debug key) - it must match the redirect URI
            in res/raw/msal_config.json and the one registered in Azure. A build signed with another
            key needs its own hash in all three places.
        -->
        <activity android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="msauth"
                    android:host="com.privat.pitz.financehelper"
                    android:path="/U/Wkv9DHlSwK6kQzTOMD9jdiJnI=" />
            </intent-filter>
        </activity>
    </application>

</manifest>