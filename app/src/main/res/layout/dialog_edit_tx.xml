<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="5dp"
        android:gravity="center"
        android:text="@string/label_date"
        android:background="@drawable/bg_default_button" />

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="5dp"
        android:gravity="center"
        android:text="@string/label_time"
        android:background="@drawable/bg_default_button" />

    <EditText
        android:id="@+id/et_description"
        android:layout_margin="3dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/label_description" />

    <EditText
        android:id="@+id/et_amount"
        android:layout_margin="3dp"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="@string/label_amount" />

    <TextView
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:text="@string/label_account" />

    <!-- tapping opens AccountPickerDialog; turns highlighted once a different account is picked -->
    <TextView
        android:id="@+id/tv_account"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="16sp"
        android:textColor="@color/colorPrimary"
        android:background="@drawable/bg_button_outlined"
        android:drawableEnd="@drawable/ic_arrow_down_24"
        android:drawableTint="@color/colorPrimary" />

    <CheckBox
        android:id="@+id/cb_update_counterpart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:checked="false"
        android:text="@string/label_update_counterpart" />

</LinearLayout>